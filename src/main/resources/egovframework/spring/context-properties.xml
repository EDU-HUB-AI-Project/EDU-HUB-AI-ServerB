<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:context="http://www.springframework.org/schema/context"
    xsi:schemaLocation="http://www.springframework.org/schema/beans 
        http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context-4.0.xsd">

	<context:property-placeholder location = "classpath:/globals.properties" />

    <bean name="propertiesService" class="egovframework.rte.fdl.property.impl.EgovPropertyServiceImpl" destroy-method="destroy">
        <property name="properties">
            <map>
                <entry key="pageUnit" value="10"/>
                <entry key="pageSize" value="10"/>
                <entry key="chrome.path" value="C:/Program Files (x86)/Google/Chrome/Application/chrome.exe"/>
                <entry key="badge.print.output" value="C:/test/"/>
	            <entry key="kiosk.site" value="ulsan"/>
	            <entry key="kiosk.contact.phone" value="000-0000-0000"/>
				<entry key="kiosk.contact.location" value="1층 안내데스크"/>
	            <!-- <entry key="kiosk.site" value="incheon"/> -->
	            
            </map>
        </property>
        <property name="extFileName">
        	<set>
            	<value>classpath:/globals.properties</value>
        	</set>
   		</property>
    </bean>

</beans>